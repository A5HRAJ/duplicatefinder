# build outputs (regenerated by build.sh)
build/
dist/

# test-time downloads and deps (fetched by test/run.sh)
test/ext/
test/node_modules/
test/package-lock.json

# scratch left behind when run-arm.sh is interrupted before its cleanup trap
test/.armwork.*
test/.arm-bin/

# local `go build` output in the source dir
server/dupfinder

# local tool state
.claude/
.DS_Store

# python bytecode cache (tools/make_icons.py)
__pycache__/
